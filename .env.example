# docker compose 变量（复制为 .env 后按需修改；.env 不入 Git）
# 不创建 .env 时，docker-compose.yml 里的默认值同样可以直接跑起来。

# 数据库 root 密码（容器内 root，MySQL 不允许空密码）
DB_PASSWORD=expo_root_pwd

# 库名，需与 backend/scripts/init.sql 一致
DB_NAME=project_showcase

# 管理员 JWT 签名密钥（对外部署必须改）
JWT_SECRET=dev-only-change-me

# 首次启动自动创建的超级管理员账号
ADMIN_USER=admin
ADMIN_INIT_PASSWORD=admin123456
