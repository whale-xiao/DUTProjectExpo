# 复制为 .env 后填写真实值（.env 不入 Git）
SERVER_PORT=8080

# MySQL（本地 5.7 / WSL 或云上 8.0 通用）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=project_showcase

# 管理员 Token 签名密钥（生产必改）
JWT_SECRET=dev-only-change-me

# 首次启动自动创建的超级管理员（首登后建议改密）
ADMIN_USER=admin
ADMIN_INIT_PASSWORD=admin123456

# V1 图片本地存储（二期迁 OSS 时换 STORAGE_DRIVER）
UPLOAD_DIR=./uploads
STORAGE_DRIVER=local
